{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@slopboy/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@slopboy/hardware": [
        "packages/hardware/src/index.ts"
      ],
      "@slopboy/cartridge": [
        "packages/cartridge/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tools/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
