{
  "name": "slopboy",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm icons:build && pnpm cartridge:build && pnpm --filter @slopboy/web dev",
    "build": "pnpm icons:build && pnpm cartridge:build && pnpm cartridge:attest && pnpm kaplay:spike-build && pnpm offline:build && pnpm --filter @slopboy/web build",
    "lint": "pnpm --filter @slopboy/web lint",
    "typecheck": "pnpm --filter @slopboy/web typecheck && pnpm exec tsc --noEmit -p tsconfig.tools.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "cartridge:build": "node --experimental-strip-types tools/build-catalog.ts build",
    "cartridge:verify": "node --experimental-strip-types tools/build-catalog.ts verify",
    "cartridge:attest": "node --experimental-strip-types tools/attest-curated-revisions.ts --verify",
    "offline:build": "node --experimental-strip-types tools/build-offline.ts",
    "icons:build": "node --experimental-strip-types tools/build-icons.ts",
    "creator:new": "node --experimental-strip-types tools/creator-cli.ts new",
    "creator:check": "node --experimental-strip-types tools/creator-cli.ts check",
    "creator:build": "node --experimental-strip-types tools/creator-cli.ts build",
    "creator:verify": "node --experimental-strip-types tools/creator-cli.ts verify",
    "security:browser": "node --experimental-strip-types tools/browser-security-smoke.ts",
    "creator:preview": "node --experimental-strip-types tools/creator-cli.ts preview",
    "security:creator-preview": "node --experimental-strip-types tools/creator-preview-smoke.ts",
    "security:pwa-browser": "node --experimental-strip-types tools/offline-browser-smoke.ts",
    "security:runtime-routes": "node --experimental-strip-types tools/runtime-route-smoke.ts && pnpm security:auth-routes",
    "security:auth-routes": "node --experimental-strip-types tools/auth-route-smoke.ts",
    "security:v2-browser": "node --experimental-strip-types tools/v2-browser-smoke.ts",
    "kaplay:spike-build": "node --experimental-strip-types tools/build-kaplay-spike.ts",
    "security:kaplay-spike": "node --experimental-strip-types tools/kaplay-browser-smoke.ts",
    "security:kaplay-host": "node --experimental-strip-types tools/kaplay-host-browser-smoke.ts",
    "template:cli": "node --experimental-strip-types tools/template-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "kaplay": "3001.0.19"
  }
}
